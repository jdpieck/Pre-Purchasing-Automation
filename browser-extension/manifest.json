{
  "manifest_version": 3,
  "name": "Pre-Purchasing Assistant for UC Davis (Beta)",
  "version": "0.1.0",
  "description": "Automate order entry into the UC Davis Pre-Purchasing portal directly from CSV spreadsheets (Beta).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://prepurchasing.ucdavis.edu/Order/Request/*",
        "https://prepurchasing.ucdavis.edu/Order/Edit/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "src/icons.js",
        "src/constants.js",
        "src/template.js",
        "src/dom_helpers.js",
        "src/parser.js",
        "src/autofill.js",
        "src/ui.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Pre-Purchasing Assistant for UC Davis (Beta)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.svg",
        "icons/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
